@echo off
call "@REDIS_VCVARS@" >nul
if errorlevel 1 exit /b %errorlevel%
if "%1"=="configure" goto configure
if "%1"=="build" goto build
if "%1"=="install" goto install
exit /b 2
:configure
"@PERL_EXECUTABLE@" "@_openssl_source@/Configure" VC-WIN64A no-shared no-tests no-apps no-module no-legacy no-asm "--prefix=@OPENSSL_ROOT_DIR@" --libdir=lib
exit /b %errorlevel%
:build
nmake
exit /b %errorlevel%
:install
nmake install_sw
exit /b %errorlevel%
