if(NOT TARGET OpenSSL::Crypto OR NOT TARGET OpenSSL::SSL)
    set(OpenSSL_FOUND FALSE)
    set(OpenSSL_NOT_FOUND_MESSAGE "The project's private OpenSSL targets have not been defined")
    return()
endif()

set(OpenSSL_VERSION "@OPENSSL_VERSION@")
set(OPENSSL_VERSION "${OpenSSL_VERSION}")
set(OPENSSL_INCLUDE_DIR "@OPENSSL_INCLUDE_DIR@")
set(OPENSSL_CRYPTO_LIBRARY "@OPENSSL_CRYPTO_LIBRARY@")
set(OPENSSL_SSL_LIBRARY "@OPENSSL_SSL_LIBRARY@")
set(OpenSSL_Crypto_FOUND TRUE)
set(OpenSSL_SSL_FOUND TRUE)
set(OpenSSL_FOUND TRUE)
set(OPENSSL_FOUND TRUE)
message(STATUS "Using project-built OpenSSL ${OpenSSL_VERSION}")
